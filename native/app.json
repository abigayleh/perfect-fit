{
  "expo": {
    "name": "Perfect Fit",
    "slug": "perfect-fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "perfectfit",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.abigaylehickey.perfectfit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.abigaylehickey.perfectfit",
      "adaptiveIcon": {
        "backgroundColor": "#A86631"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d13f5540-7b30-407b-9617-ace5df0c6620"
      }
    },
    "owner": "abigayleh"
  }
}
